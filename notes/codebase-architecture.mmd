%% openindex / dither — system architecture
%% 3 process roles · 3 fire sources funnel into fireWithSuppress · split-brain daemon · FS as wire
flowchart TB

  classDef cli fill:#58a6ff,stroke:#1f6feb,color:#0d1117;
  classDef daemon fill:#f0883e,stroke:#bd561d,color:#0d1117;
  classDef plugin fill:#7ee787,stroke:#2ea043,color:#0d1117;
  classDef fs fill:#21262d,stroke:#8b949e,color:#c9d1d9;

  subgraph CLI["CLI process (short-lived)"]
    cmd["dit &lt;command&gt;"]:::cli
    ensure["ensureDaemonForPlugin"]:::cli
    client["daemonClient.triggerAndWatch"]:::cli
  end

  subgraph DAEMON["daemon process (long-lived)"]
    direction TB
    subgraph FIRE["Fire path — plugins"]
      sched["Scheduler (cron)"]:::daemon
      watch["Watcher (chokidar → inbox)"]:::daemon
      refire["Refirer (timer-per-row)"]:::daemon
      loop["LoopDetector"]:::daemon
      fws["fireWithSuppress(name, trigger)"]:::daemon
      run["runPlugin"]:::daemon
    end
    subgraph JOBS["Index path — qmd (split brain, in-process)"]
      reconcile["qmdReconcile"]:::daemon
      idx["runIndexJob"]:::daemon
      emb["runEmbedJob"]:::daemon
    end
    pidfile["status.json + dither.pid"]:::daemon
  end

  subgraph PLUGIN["plugin (Deno subprocess, per run)"]
    deno["deno run --allow-* user-plugin"]:::plugin
    promote["planPromotion → library/"]:::plugin
  end

  subgraph FS["filesystem wire — ~/.dither/"]
    home[("locks/ inboxes/ inflight/ refires/<br/>history/&lt;runId&gt;/ runs/&lt;runId&gt;/<br/>jobs/ qmd-index.sqlite<br/>needs-reindex · embed-disabled<br/>run-log.jsonl · kicks/")]:::fs
  end

  %% CLI ↔ daemon: spawn (solid) + signals (dashed)
  cmd --> ensure
  ensure ==>|"spawn if dead"| DAEMON
  cmd --> client
  client -. "SIGHUP (reload + reconcile)" .-> DAEMON
  client -. "SIGTERM (shutdown)" .-> DAEMON

  %% Fire funnel — 3 sources + manual kick all flow through fws
  sched --> fws
  watch --> fws
  refire --> fws
  cmd -->|"write kicks/*.json"| home
  home -->|"scanKicks"| fws
  loop -. "shouldHalt?" .-> fws
  fws ==>|"acquire(name) lock"| run
  run ==>|"spawn"| deno
  deno --> promote

  %% Split-brain: jobs loop runs in-process, no subprocess
  reconcile --> idx
  reconcile --> emb

  %% FS as wire
  fws <--> home
  run <--> home
  deno -->|"runs/&lt;id&gt;/*.md"| home
  reconcile <--> home
  DAEMON --> pidfile
  client <-->|"poll status.json + run-log.jsonl"| home
