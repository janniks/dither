---
title: API surfaces — one impl, two namings
---
flowchart LR
    subgraph NAMED["Named locks (plugins, daemon-start)"]
        A1["acquire(name)"]
        A2["release(handle)"]
        A3["isLockHeld(name)"]
    end

    subgraph THEME["Theme locks (qmd-download, qmd-index, qmd-embed — job serialisers)"]
        T1["acquireTheme(theme)"]
        T2["releaseTheme(handle)"]
        T3["status(theme)"]
    end

    IMPL["Single impl: O_EXCL create + PID body + bounded retry"]

    A1 --> IMPL
    A2 --> IMPL
    A3 --> IMPL
    T1 --> IMPL
    T2 --> IMPL
    T3 --> IMPL

    T1 -. "delegates to" .-> A1
    T2 -. "delegates to" .-> A2

    NOTE["Two surfaces is deliberate — different semantics. Themes are just named locks ('qmd-theme'). The term 'lock theme' was dropped post-phase-4; see CONTEXT.md Lock entry."]

    IMPL --- NOTE
