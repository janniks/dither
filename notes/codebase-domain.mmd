%% openindex domain language — relationships between defined terms in CONTEXT.md
%% Source of truth: CONTEXT.md (post-phase-4)
flowchart LR

  subgraph content["content"]
    Library["Library<br/>(root dir)"]
    Collection["Collection<br/>(subdir)"]
    Entry["Entry<br/>(.md file)"]
    Grant["Grant<br/>(glob + collection)"]
  end

  subgraph plugin_lifecycle["plugin lifecycle"]
    Plugin["Plugin"]
    Run["Run<br/>(sortable runId)"]
    Promotion["Promotion<br/>(staged → Collection)"]
  end

  subgraph daemon_grp["daemon"]
    Daemon["Daemon<br/>(long-lived process)"]
    Job["Job<br/>(index / embed / model-download)"]
    qmd["qmd<br/>(@tobilu/qmd SDK)"]
    Indexing["Indexing<br/>(verb: scan → FTS)"]
    Embedding["Embedding<br/>(verb: vectorise chunks)"]
  end

  subgraph wire["daemon ↔ CLI wire"]
    Lock["Lock<br/>(O_EXCL mutex)"]
    Kick["Kick<br/>(run plugin X now)"]
    Refire["Refire<br/>(Kick + retry/schedule)"]
    Inbox["Inbox<br/>(watch-event NDJSON)"]
    Marker["Marker<br/>(lazy form of Signal)"]
    RunLog["Run-log<br/>(global + per-Run JSONL)"]
    Signal["Signal<br/>(SIGHUP / SIGTERM / SIGINT)"]
  end

  %% content containment
  Library -- "contains" --> Collection
  Collection -- "contains" --> Entry

  %% grants + authorship
  Plugin -- "declares" --> Grant
  Grant -- "authorises writes to" --> Collection
  Plugin -- "produces" --> Entry
  Entry -- "via" --> Promotion
  Promotion -- "during" --> Run
  Plugin -- "executes as" --> Run

  %% run-log scopes
  Run -- "writes events to (per-run)" --> RunLog
  Daemon -- "writes events to (global)" --> RunLog

  %% daemon work
  Daemon -- "dispatches" --> Job
  Job -- "acquires" --> Lock
  Job -- "performs" --> Indexing
  Job -- "performs" --> Embedding
  Indexing -- "on" --> qmd
  Embedding -- "on" --> qmd
  Indexing -- "scans" --> Library

  %% wire-level glue
  Kick -- "extended by" --> Refire
  Refire -- "fires" --> Run
  Kick -- "fires" --> Run
  Inbox -- "feeds" --> Run
  Marker -- "lazy form of" --> Signal
  Signal -- "wakes" --> Daemon
  Marker -- "checked by" --> Daemon
  Daemon -- "consumes" --> Kick
  Daemon -- "consumes" --> Inbox
  Daemon -- "holds timers for" --> Refire

  %% styling
  classDef content fill:#eef7ee,stroke:#4a7c4a,color:#1b3a1b
  classDef life fill:#eef2f9,stroke:#46618a,color:#1b2a44
  classDef daem fill:#fff3e6,stroke:#a36a1f,color:#3a2608
  classDef wire fill:#f5ecf7,stroke:#7a4a8a,color:#2e1b3a

  class Library,Collection,Entry,Grant content
  class Plugin,Run,Promotion life
  class Daemon,Job,qmd,Indexing,Embedding daem
  class Lock,Kick,Refire,Inbox,Marker,RunLog,Signal wire
