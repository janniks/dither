%% openindex IPC primitives — who writes / reads each
%% Sources: CONTEXT.md "Daemon ↔ CLI wire", notes/ipc-graph.html,
%% packages/cli/src/{locks,kicks,inbox,refire,markers,run-log}.ts
flowchart LR

  %% ===== actors =====
  subgraph ACTORS [actors]
    direction TB
    CLI([CLI])
    DAEMON([daemon])
    WATCHER([watcher])
    SCHED([scheduler])
    REFIRER([refirer])
    PLUGIN([plugin Deno])
    PROMO([promotion])
    RECON([reconciler])
  end

  %% ===== primitives =====
  subgraph PRIMS ["~/.dither/ — file-based wire + POSIX"]
    direction TB
    LOCK["locks/&lt;name&gt;.lock<br/>O_EXCL · body = holder PID"]
    KICK["kicks/&lt;plugin&gt;.json<br/>CLI → daemon: run plugin X"]
    REFIRE["refires/&lt;plugin&gt;.json<br/>kick + retry/schedule state"]
    INBOX["inboxes/&lt;plugin&gt;.ndjson<br/>at-least-once: rename → inflight/"]
    MARKER["markers/&lt;name&gt;<br/>needs-reindex · embed-disabled"]
    RUNLOG["run-log.jsonl<br/>+ history/&lt;runId&gt;/events.jsonl"]
    SIGNAL>"POSIX · SIGHUP/SIGTERM/SIGINT"]
  end

  %% ===== signal =====
  CLI -- "send SIGHUP/SIGTERM" --> SIGNAL
  SIGNAL -- "deliver" --> DAEMON

  %% ===== kick =====
  CLI -- "write" --> KICK
  DAEMON -- "read · consume on SIGHUP" --> KICK

  %% ===== refire =====
  DAEMON -- "write · decideRunOutcome" --> REFIRE
  REFIRER -- "read · one timer per row" --> REFIRE

  %% ===== inbox =====
  WATCHER -- "append NDJSON" --> INBOX
  DAEMON -- "claim · rename inbox→inflight" --> INBOX
  DAEMON -- "restoreInflight on failure" --> INBOX

  %% ===== marker =====
  CLI -- "touch · index cancel/update" --> MARKER
  PROMO -- "touch needs-reindex" --> MARKER
  RECON -- "read · rename · unlink" --> MARKER

  %% ===== lock =====
  DAEMON -- "acquire &lt;plugin&gt; · runPlugin" --> LOCK
  RECON -- "acquire qmd-index/embed/download" --> LOCK
  CLI -- "read status(theme)" --> LOCK

  %% ===== run-log =====
  DAEMON -- "append global + per-run" --> RUNLOG
  PLUGIN -- "stderr → append per-run" --> RUNLOG
  CLI -- "tail from pinned offset" --> RUNLOG

  %% ===== scheduler funnels into fire path (no primitive) =====
  SCHED -. "in-process → fireWithSuppress" .-> DAEMON

  %% ===== styles by primitive =====
  classDef lock    fill:#2a1a0e,stroke:#f0883e,color:#f0883e;
  classDef kick    fill:#0e1a2a,stroke:#58a6ff,color:#58a6ff;
  classDef refire  fill:#0e2628,stroke:#39c5cf,color:#39c5cf;
  classDef inbox   fill:#1c0e2a,stroke:#a371f7,color:#a371f7;
  classDef marker  fill:#2a0e0e,stroke:#ff7b72,color:#ff7b72;
  classDef runlog  fill:#0e2a16,stroke:#7ee787,color:#7ee787;
  classDef signal  fill:#2a0e22,stroke:#ff79c6,color:#ff79c6;

  class LOCK lock;
  class KICK kick;
  class REFIRE refire;
  class INBOX inbox;
  class MARKER marker;
  class RUNLOG runlog;
  class SIGNAL signal;

  %% edge coloring by primitive
  linkStyle 0,1 stroke:#ff79c6,stroke-width:1.6px;
  linkStyle 2,3 stroke:#58a6ff,stroke-width:1.6px;
  linkStyle 4,5 stroke:#39c5cf,stroke-width:1.6px;
  linkStyle 6,7,8 stroke:#a371f7,stroke-width:1.6px;
  linkStyle 9,10,11 stroke:#ff7b72,stroke-width:1.6px;
  linkStyle 12,13,14 stroke:#f0883e,stroke-width:1.6px;
  linkStyle 15,16,17 stroke:#7ee787,stroke-width:1.6px;
  linkStyle 18 stroke:#8b949e,stroke-width:1.2px,stroke-dasharray:5 4;
