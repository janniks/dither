flowchart TB
    root["~/.dither/"]

    %% top-level snapshots + runlog + db
    pid["dither.pid<br/>daemon identity (pid/token/startedAt)"]
    status["status.json<br/>event-driven snapshot (lastUpdated)"]
    env["env.json<br/>global env values"]
    config["config.json<br/>install config (library.path)"]
    runlog["run-log.jsonl<br/>global event stream (trunc on daemon start)"]
    qmd["qmd-index.sqlite<br/>qmd database"]

    root --> pid
    root --> status
    root --> env
    root --> config
    root --> runlog
    root --> qmd

    %% markers/ (phase-6: moved into subdir)
    markersDir["markers/"]
    needsReindex["needs-reindex<br/>request flavour<br/>written by promotion, claimed by reconciler"]
    embedDisabled["embed-disabled<br/>state flavour<br/>set by 'index cancel', cleared by 'index update'"]
    root --> markersDir
    markersDir --> needsReindex
    markersDir --> embedDisabled

    %% locks/
    locksDir["locks/"]
    pluginLock["&lt;plugin&gt;.lock<br/>per-plugin exclusion during run"]
    qmdDownload["qmd-download.lock<br/>named job serialiser"]
    qmdIndex["qmd-index.lock<br/>named job serialiser"]
    qmdEmbed["qmd-embed.lock<br/>named job serialiser"]
    daemonStart["daemon-start.lock<br/>single-spawn guard"]
    root --> locksDir
    locksDir --> pluginLock
    locksDir --> qmdDownload
    locksDir --> qmdIndex
    locksDir --> qmdEmbed
    locksDir --> daemonStart

    %% kicks/
    kicksDir["kicks/"]
    kickFile["&lt;plugin&gt;.json<br/>CLI to daemon"]
    root --> kicksDir
    kicksDir --> kickFile

    %% inboxes/ + inflight/
    inboxesDir["inboxes/"]
    inboxFile["&lt;plugin&gt;.ndjson<br/>watcher to daemon"]
    root --> inboxesDir
    inboxesDir --> inboxFile

    inflightDir["inflight/"]
    inflightFile["&lt;plugin&gt;.ndjson<br/>claimed-but-unfinished"]
    root --> inflightDir
    inflightDir --> inflightFile

    %% refires/
    refiresDir["refires/"]
    refireFile["&lt;plugin&gt;.json<br/>reschedule state"]
    root --> refiresDir
    refiresDir --> refireFile

    %% history/<runId>/
    historyDir["history/&lt;runId&gt;/<br/>per-run journal"]
    manifest["manifest.json<br/>run identity (+ childPid post-spawn)"]
    events["events.jsonl<br/>progress/stderr/added/reschedule"]
    result["result.json<br/>terminal (ok/fail); tmp+rename"]
    root --> historyDir
    historyDir --> manifest
    historyDir --> events
    historyDir --> result

    %% runs/<runId>/
    runsDir["runs/&lt;runId&gt;/<br/>ephemeral plugin scratch (rm -rf in finally)"]
    input["input.json<br/>trigger, env, files, targets, net"]
    mdOut["*.md<br/>plugin outputs (validated to library)"]
    root --> runsDir
    runsDir --> input
    runsDir --> mdOut

    %% jobs/
    jobsDir["jobs/"]
    jobFile["&lt;jobId&gt;.json<br/>qmd job inflight snapshot"]
    root --> jobsDir
    jobsDir --> jobFile

    %% plugins/, grants/, bin/, logs/
    pluginsDir["plugins/&lt;name&gt;/<br/>installed plugin code + state/"]
    grantsDir["grants/"]
    grantFile["&lt;plugin&gt;.json<br/>consented permissions"]
    binDir["bin/"]
    deno["deno-&lt;version&gt;<br/>managed Deno binary"]
    logsDir["logs/"]
    daemonLog["daemon.log<br/>stdout/stderr"]
    root --> pluginsDir
    root --> grantsDir
    grantsDir --> grantFile
    root --> binDir
    binDir --> deno
    root --> logsDir
    logsDir --> daemonLog

    %% classDefs coloured by primitive
    classDef lockCls fill:#f0883e,stroke:#2d333b,color:#0d1117
    classDef kickCls fill:#58a6ff,stroke:#2d333b,color:#0d1117
    classDef inboxCls fill:#a371f7,stroke:#2d333b,color:#ffffff
    classDef refireCls fill:#39c5cf,stroke:#2d333b,color:#0d1117
    classDef markerCls fill:#ff7b72,stroke:#2d333b,color:#0d1117
    classDef runlogCls fill:#7ee787,stroke:#2d333b,color:#0d1117
    classDef snapshotCls fill:#8b949e,stroke:#2d333b,color:#0d1117
    classDef neutralCls fill:#c9d1d9,stroke:#2d333b,color:#0d1117
    classDef dirCls fill:#21262d,stroke:#8b949e,color:#c9d1d9

    %% assignments
    class pid,status,env,config snapshotCls
    class runlog,events runlogCls
    class needsReindex,embedDisabled markerCls
    class pluginLock,qmdDownload,qmdIndex,qmdEmbed,daemonStart lockCls
    class kickFile kickCls
    class inboxFile,inflightFile inboxCls
    class refireFile refireCls
    class qmd,jobFile,manifest,result,input,mdOut,pluginsDir,grantFile,deno,daemonLog neutralCls
    class root,markersDir,locksDir,kicksDir,inboxesDir,inflightDir,refiresDir,historyDir,runsDir,jobsDir,grantsDir,binDir,logsDir dirCls
