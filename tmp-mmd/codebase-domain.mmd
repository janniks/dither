%% openindex domain language — relationships between defined terms in CONTEXT.md
%% Source of truth: CONTEXT.md (post-phase-4).

flowchart LR
  subgraph content[content]
    Library(Library):::content
    Collection(Collection):::content
    Entry(Entry):::content
    Grant(Grant):::content
  end

  subgraph lifecycle[plugin lifecycle]
    Plugin(Plugin):::plug
    Run(Run):::plug
    Promotion(Promotion):::plug
  end

  subgraph daemon_grp[daemon]
    Daemon(Daemon):::dae
    Job(Job):::dae
    qmd(qmd):::dae
    Indexing(Indexing):::dae
    Embedding(Embedding):::dae
  end

  subgraph wire[daemon - CLI wire]
    Lock(Lock):::lock
    Kick(Kick):::kick
    Refire(Refire):::refire
    Inbox(Inbox):::inbox
    Marker(Marker):::marker
    RunLog(Run-log):::runlog
    Signal(Signal):::signal
  end

  Library -->|contains| Collection
  Collection -->|contains| Entry
  Plugin -->|declares| Grant
  Grant -->|authorises writes to| Collection
  Plugin -->|executes as| Run
  Run -->|produces via Promotion| Entry
  Promotion -->|stages into| Collection

  Run -->|writes per-run scope| RunLog
  Daemon -->|writes global scope| RunLog

  Daemon -->|dispatches| Job
  Job -->|acquires| Lock
  Job -->|performs| Indexing
  Job -->|performs| Embedding
  Indexing -->|scans| Library
  Indexing --> qmd
  Embedding --> qmd

  Kick -->|fires| Run
  Refire -->|fires| Run
  Inbox -->|feeds| Run
  Marker -.->|lazy form of| Signal
  Signal -->|reload + reconcile| Daemon
  Daemon -->|consumes| Kick
  Daemon -->|claims| Inbox
  Daemon -->|holds timer for| Refire

