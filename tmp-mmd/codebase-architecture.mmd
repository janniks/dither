%% openindex / dither — system architecture
%% 3 process roles; 3 fire sources funnel into fireWithSuppress; FS is the wire.

flowchart TB
  subgraph User[user]
    Shell([shell])
  end

  subgraph CLI[CLI process]
    CliCmd(dither cmd)
    Search(search)
    Get(get)
    Status(status)
  end

  subgraph Daemon[daemon - long lived]
    Scheduler(Scheduler):::source
    Watcher(Watcher):::source
    Refirer(Refirer):::source
    Fire{fireWithSuppress}:::hub
    Loop{LoopDetector}:::hub
    RunPlugin(runPlugin)
    Reconciler(qmdReconcile):::reconciler
    IndexJob(runIndexJob):::reconciler
    EmbedJob(runEmbedJob):::reconciler
  end

  subgraph Plugin[plugin - Deno subprocess]
    Deno(plugin code):::plugin
  end

  subgraph FS[home/.dither]
    Locks(locks):::lock
    Kicks(kicks):::kick
    Inboxes(inboxes):::inbox
    Refires(refires):::refire
    Markers(markers):::marker
    History(history):::runlog
    RunLog(run-log.jsonl):::runlog
    Qmd(qmd-index.sqlite)
    Status_json(status.json)
    Pid(dither.pid)
  end

  Shell --> CliCmd
  CliCmd -.->|SIGHUP / SIGTERM| Daemon
  CliCmd ==>|autospawn if dead| Daemon
  Search --> Qmd
  Get --> Qmd
  Status --> Status_json

  CliCmd --> Kicks
  Daemon --> Kicks

  Scheduler --> Fire
  Watcher --> Fire
  Refirer --> Fire
  Watcher --> Inboxes
  Fire --> Loop
  Loop --> RunPlugin
  RunPlugin --> Locks
  RunPlugin --> Inboxes
  RunPlugin --> Refires
  RunPlugin --> Markers
  RunPlugin --> History
  RunPlugin --> RunLog
  RunPlugin ==>|spawn Deno| Deno

  Reconciler --> Markers
  Reconciler --> IndexJob
  Reconciler --> EmbedJob
  IndexJob --> Locks
  IndexJob --> Qmd
  EmbedJob --> Locks
  EmbedJob --> Qmd

  Daemon --> Status_json
  Daemon --> Pid
  Daemon --> RunLog

