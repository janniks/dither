%% openindex lock primitive — packages/cli/src/locks.ts
%% State machine (top) + API surface legend (bottom). Converted from stateDiagram-v2.

flowchart LR
  Start((start)) --> Free(Free):::state

  Free -->|acquire wx + write PID| Acquired(Acquired):::state
  Free -->|EEXIST and holder PID dead| Stale(Stale):::state

  Stale -->|unlink and retry up to 3| Acquired
  Stale -->|EEXIST and still dead| Stale

  Acquired -->|release verify PID and unlink| Free
  Acquired -->|holder process crashes| Stale

  Free -.->|EEXIST and holder PID alive| Free
  Acquired -->|isLockHeld returns true| Acquired

  subgraph api[API surfaces - one impl]
    Named(named locks):::surface
    Theme(theme locks):::surface
    Impl(open path wx with PID body):::impl

    Named -->|acquire name| Impl
    Named -->|release handle| Impl
    Named -->|isLockHeld name| Impl

    Theme -->|acquireTheme theme| Impl
    Theme -->|releaseTheme handle| Impl
    Theme -->|status theme| Impl
  end

  classDef state fill:#f0883e
  classDef surface fill:#58a6ff
  classDef impl fill:#7ee787

  %% notes: {"Free":"No lock file at the path.","Acquired":"Lock file exists with this process PID body.","Stale":"Lock file exists but holder PID is dead. Reclaim via unlink-and-retry.","Named":"Used for plugins and daemon-start: locks/<name>.lock.","Theme":"Used for qmd job serialisers: locks/qmd-{download,index,embed}.lock. Pre-phase-4 these were called 'lock themes'; now just named locks."}
